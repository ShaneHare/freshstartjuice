# Local testing only -- copy this file to .env (already gitignored, never committed)
# and fill in real values. `netlify dev` loads .env automatically.

# Same Stripe secret key you saved in Netlify's environment variables.
STRIPE_SECRET_KEY=

# Do NOT reuse the production webhook secret here. Running `stripe listen`
# (see STRIPE-WEBHOOK-SETUP.md) prints a DIFFERENT signing secret just for
# your local session -- paste that one in below.
STRIPE_WEBHOOK_SECRET=
